    {id:7, q:"Что необходимо взять с собой на отдых?", a:"Рекомендуем взять только удобную одежду по погоде, купальники и ваше прекрасное настроение. Мягкие халаты, тапочки, белоснежное постельное белье и свежие полотенца уже бережно разложены в домиках."},
    {id:8, q:"Выдаются ли отчетные документы и кассовые чеки?", a:"Да, мы работаем абсолютно официально. При заезде или бронировании мы предоставляем фискальные кассовые чеки, а по запросу подготовим полный пакет документов для вашей бухгалтерии."}
];

let currentOpenFaq = 1;

function renderFaq() {
    const container = document.getElementById('faq-list');
    container.innerHTML = '';
    faqs.forEach(item => {
        const isOpen = currentOpenFaq === item.id;
        container.innerHTML += `
            <div class="faq-item">
                <button class="faq-trigger" onclick="toggleFaq(${item.id})">
                    <span>${item.q}</span>
                    <div class="faq-ind${isOpen ? ' open' : ''}">${isOpen ? '−' : '+'}</div>
                </button>
                <div class="faq-answer${isOpen ? ' open' : ''}">
                    <div class="faq-answer-inner">${item.a}</div>
                </div>
            </div>
        `;
    });
}

function toggleFaq(id) {
    currentOpenFaq = currentOpenFaq === id ? null : id;
    renderFaq();
}

renderFaq();

