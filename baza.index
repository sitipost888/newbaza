<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- ===== SEO: ОСНОВНЫЕ МЕТА-ТЕГИ ===== -->
<title>Горная Усадьба — База отдыха в горах, где отдыхают душой</title>
<meta name="description" content="Горная Усадьба — уютная база отдыха в горах. Домики с панорамными окнами, баня, бассейн, чан. Тишина, природа, настоящий отдых.">
<meta name="keywords" content="база отдыха в горах, отдых в горах, домики в горах, Горная Усадьба, отдых у горного озера, баня в горах, бассейн горы, глэмпинг в горах">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://sitipost888.github.io/usadbam/">

<!-- ===== SEO: ФАВИКОН (ЛОГОТИП В БРАУЗЕРЕ) ===== -->
<link rel="icon" type="image/png" href="images/logo.jpg">
<link rel="apple-touch-icon" href="images/logo.jpg">

<!-- ===== SEO: OPEN GRAPH (ВКонтакте, Telegram, WhatsApp) ===== -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://sitipost888.github.io/usadbam/">
<meta property="og:title" content="Горная Усадьба — Место, где отдыхают душой">
<meta property="og:description" content="Уютная база отдыха в горах. Домики с панорамными окнами, тёплый бассейн, баня, горный воздух.">
<meta property="og:image" content="images/head.jpg">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="Горная Усадьба">

<!-- ===== SEO: SCHEMA.ORG — РАЗМЕТКА ДЛЯ GOOGLE ===== -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": "Горная Усадьба",
  "description": "Уютная база отдыха в горах. Домики с тёплым полом, бассейн, баня, банный чан. Тишина, природа, настоящий отдых.",
  "url": "https://sitipost888.github.io/usadbam/",
  "telephone": "+7-923-570-33-35",
  "image": "images/head.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "Горный Алтай",
    "addressCountry": "RU",
    "addressLocality": "Горный Алтай"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "43.979055",
    "longitude": "41.540890"
  },
  "amenityFeature": [
    {"@type": "LocationFeatureSpecification", "name": "Бассейн с подогревом", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Баня на дровах", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Банный чан", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Wi-Fi", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Парковка", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Мангальная зона", "value": true}
  ],
  "checkinTime": "14:00",
  "checkoutTime": "12:00",
  "currenciesAccepted": "RUB",
  "paymentAccepted": "Cash, Credit Card",
  "priceRange": "₽₽"
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Lora:ital,wght@1,300;1,400;1,500;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Inter',sans-serif;
  --editorial:'Lora',Georgia,serif;
  --warm:#a4907c;
  --warm-dark:#8e7a68;
  --cream:#FAF9F5;
  --sand:#F4F2EA;
  --dark:#1e1714;
}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:var(--sans);background:var(--dark);color:#1c1917;overflow-x:hidden;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-thumb{background:#d6d3d1;border-radius:3px}
img{display:block;max-width:100%}
button{cursor:pointer;font-family:var(--sans)}
a{text-decoration:none;color:inherit}

/* NAVBAR */
.navbar{position:fixed;top:0;left:0;width:100%;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:2rem 4rem;transition:all .5s}
.logo-wrap{display:flex;align-items:center;gap:.75rem}
.logo-img{width:3rem;height:3rem;border-radius:50%;overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.2)}
.logo-img img{width:100%;height:100%;object-fit:cover;transform:scale(1.18)}
.logo-name{font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:rgba(255,255,255,.95);font-weight:300}

/* HERO */
.hero{position:relative;height:100vh;min-height:700px;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center;background:var(--dark)}
.hero-bg{position:absolute;inset:0}
.hero-overlay{position:absolute;inset:0;background:rgba(0,0,0,.28);z-index:1}
.hero-bg img{width:100%;height:100%;object-fit:cover;filter:brightness(.9) saturate(1.1)}
.hero-loc{position:absolute;top:7rem;left:4rem;z-index:3;text-align:left;pointer-events:none}
.hero-loc span{display:block}
.hero-loc .l1{font-size:11px;letter-spacing:.22em;color:#f5e6d3;text-transform:uppercase;font-weight:500}
.hero-loc .l2{font-size:10px;letter-spacing:.18em;color:rgba(255,255,255,.6);text-transform:uppercase;font-weight:300;margin-top:.25rem}
.hero-content{position:relative;z-index:2;max-width:56rem;padding:0 1.5rem;margin-top:2rem;animation:fadeUp 1.4s cubic-bezier(.16,1,.3,1) .2s both}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.hero h1{font-family:var(--serif);color:#fff;font-size:5.5rem;line-height:.95;margin-bottom:2rem;letter-spacing:-.02em}
.hero h1 em{font-style:italic;font-weight:400;color:#f5e6d3}
.hero-sub{color:rgba(255,255,255,.85);font-size:1.1rem;max-width:32rem;margin:0 auto 3rem;font-weight:300;line-height:1.6}
.hero-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
.btn-glass{padding:.75rem 2rem;border-radius:9999px;font-size:10px;text-transform:uppercase;letter-spacing:.2em;font-weight:500;border:1px solid rgba(255,255,255,.2);color:#fff;background:rgba(255,255,255,.1);backdrop-filter:blur(12px);transition:all .3s}
.btn-glass:hover{background:rgba(255,255,255,.2);box-shadow:0 0 40px rgba(255,255,255,.15)}
.btn-glass-outline{background:transparent}
.btn-glass-outline:hover{background:rgba(255,255,255,.1)}

/* IMPRESSION */
.impression{background:var(--cream);padding:6rem 1.5rem;position:relative;overflow:hidden}
.imp-glow{position:absolute;border-radius:50%;pointer-events:none}
.imp-glow.tl{top:0;left:25%;width:24rem;height:24rem;background:#f1efe9;filter:blur(3rem);opacity:.6;transform:translateY(-50%)}
.imp-glow.br{bottom:0;right:25%;width:24rem;height:24rem;background:#eceae3;filter:blur(3rem);opacity:.5;transform:translateY(50%)}
.sec-inner{max-width:64rem;margin:0 auto;position:relative;z-index:1}
.sec-inner-wide{max-width:88rem;margin:0 auto;position:relative;z-index:1}
.title-center{text-align:center;margin-bottom:4rem}
.h2-muted{font-family:var(--serif);font-size:3rem;color:#a8a29e;letter-spacing:-.02em}
.imp-quote{max-width:48rem;margin:0 auto 4rem;text-align:center}
.imp-quote p{font-family:var(--editorial);font-style:italic;font-size:1.1rem;color:#44403c;line-height:1.7;padding:0 2rem}
.imp-divider{width:3rem;height:1px;background:#d6d3d1;margin:3rem auto 0}
.imp-banner{width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;height:480px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:var(--cream)}
.imp-img-wrap{position:relative;max-width:360px;border-radius:1rem;overflow:hidden;box-shadow:none}
.imp-img-wrap img{width:100%;height:auto;object-fit:cover;transition:transform 1s ease-out}
.imp-img-wrap:hover img{transform:scale(1.03)}
.imp-caption{position:absolute;bottom:1.5rem;left:50%;transform:translateX(-50%);color:#fff;font-family:monospace;font-size:9px;letter-spacing:.15em;text-transform:uppercase;opacity:.85;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);padding:.25rem .75rem;border-radius:9999px;border:1px solid rgba(255,255,255,.1);white-space:nowrap;z-index:2}
.imp-text{max-width:40rem;margin:2rem auto 0;font-size:1rem;line-height:1.75;color:rgba(87,83,78,.95);padding-top:2rem;border-top:1px solid rgba(214,211,209,.4)}
.imp-text p+p{margin-top:2rem}
.imp-finale{margin-top:2.5rem;text-align:center;padding:1rem}
.imp-finale p{font-family:var(--editorial);font-style:italic;font-size:1.2rem;color:#1c1917;line-height:1.6;font-weight:300}

/* SCENARIOS */
.scenarios{background:var(--sand);padding:6rem 1.5rem;position:relative;overflow:hidden;border-top:1px solid rgba(214,211,209,.5);border-bottom:1px solid rgba(214,211,209,.5)}
.sec-header-row{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:3rem}
.sec-header-row .left p{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.3em;color:var(--warm);margin-bottom:1rem}
.sec-header-row .left h2{font-family:var(--serif);font-size:3.5rem;color:#292524;letter-spacing:-.02em}
.nav-arrows{display:flex;gap:.75rem}
.nav-arr{width:3rem;height:3rem;border-radius:50%;border:1px solid #e7e5e4;display:flex;align-items:center;justify-content:center;color:#57534e;background:transparent;transition:all .3s;font-size:1.1rem}
.nav-arr:hover{color:#1c1917;background:#fafaf9;border-color:#d6d3d1}
.h-scroll{display:flex;gap:1.5rem;overflow-x:auto;padding-bottom:2rem;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
.h-scroll::-webkit-scrollbar{display:none}
.scen-card{min-width:420px;max-width:420px;scroll-snap-align:start;background:#fff;border:1px solid rgba(231,229,228,.6);border-radius:1.5rem;overflow:hidden;flex-shrink:0;box-shadow:0 8px 30px rgba(0,0,0,.015)}
.scen-img{height:320px;overflow:hidden;position:relative}
.scen-img-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(12,10,9,.4),transparent);z-index:1;opacity:.5}
.scen-img img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease-out}
.scen-card:hover .scen-img img{transform:scale(1.05)}
.scen-num{position:absolute;top:1.5rem;left:1.5rem;z-index:2;width:2rem;height:2rem;border-radius:50%;background:var(--warm);color:#fff;font-family:monospace;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center}
.scen-body{padding:2rem}
.scen-body h3{font-family:var(--serif);font-size:1.4rem;color:#292524;margin-bottom:1rem;transition:color .3s}
.scen-card:hover .scen-body h3{color:var(--warm)}
.scen-body p{font-size:.85rem;color:#78716c;line-height:1.65;font-weight:300}
.scroll-tip{text-align:center;color:#a8a29e;font-size:10px;font-family:monospace;letter-spacing:.1em;text-transform:uppercase;margin-top:1rem;display:none}

/* SERVICES */
.services{background:var(--cream);padding:6rem 1.5rem;position:relative}
.territory-intro{text-align:center;max-width:40rem;margin:0 auto 3rem}
.territory-intro h2{font-family:var(--serif);font-size:2.25rem;color:#292524}
.terr-grid{display:grid;grid-template-columns:7fr 5fr;gap:2rem;align-items:center;background:#f5f5f4;border-radius:2rem;overflow:hidden;padding:1rem;border:1px solid rgba(231,229,228,.6);margin-bottom:6rem}
.terr-img{height:400px;border-radius:1.5rem;overflow:hidden}
.terr-img img{width:100%;height:100%;object-fit:cover;filter:saturate(1.1) brightness(.95)}
.terr-text{padding:1.5rem 2rem}
.eyebrow{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.3em;color:#a8a29e;display:block;margin-bottom:.5rem}
.eyebrow-warm{color:var(--warm)!important}
.terr-text .lead{font-family:var(--serif);font-size:1.3rem;color:#292524;line-height:1.6;margin-bottom:1.5rem;font-weight:300}
.terr-divider{height:1px;background:#e7e5e4;margin:1.5rem 0}
.terr-text .body{color:#57534e;font-size:.9rem;line-height:1.7;font-weight:300}
.svc-header{text-align:center;max-width:40rem;margin:0 auto 4rem}
.svc-header h2{font-family:var(--serif);font-size:3rem;color:#292524;letter-spacing:-.02em}
.svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-bottom:6rem}
.svc-card{background:#fff;border-radius:1.5rem;border:1px solid rgba(214,211,209,.4);padding:1.25rem;box-shadow:0 2px 8px rgba(0,0,0,.02);display:flex;flex-direction:column;justify-content:space-between;transition:all .3s}
.svc-card:hover{transform:translateY(-6px);box-shadow:0 12px 30px rgba(0,0,0,.06)}
.svc-card-img{height:18rem;border-radius:1rem;overflow:hidden;margin-bottom:1.5rem;position:relative}
.svc-card-img img{width:100%;height:100%;object-fit:cover}
.svc-card h3{font-family:var(--serif);font-size:1.5rem;color:#292524;margin-bottom:.75rem}
.svc-card .desc{font-size:.875rem;color:#57534e;line-height:1.6;margin-bottom:1rem;font-weight:300}
.svc-card .quote{font-family:var(--editorial);font-style:italic;font-size:.8rem;color:rgba(120,113,108,.9);border-left:2px solid rgba(164,144,124,.3);padding:.25rem .75rem;margin-bottom:1.5rem}
.svc-more{font-size:11px;text-transform:uppercase;letter-spacing:.1em;font-weight:600;color:var(--warm);background:transparent;border:none;transition:color .2s}
.svc-more:hover{color:var(--warm-dark)}
.silence{background:#f5f5f4;border:1px solid rgba(214,211,209,.6);border-radius:1.5rem;padding:2.5rem 3rem;display:flex;align-items:center;gap:1.5rem;position:relative;overflow:hidden}
.silence-icon{width:3rem;height:3rem;border-radius:50%;background:#fff;border:1px solid #e7e5e4;display:flex;align-items:center;justify-content:center;color:var(--warm);flex-shrink:0}
.silence-text h3{font-family:var(--serif);font-size:1.35rem;color:#292524;margin-bottom:.25rem}
.silence-text p{font-size:.85rem;color:#78716c;font-weight:300;line-height:1.6}

/* FOUNDER */
.founder{background:var(--sand);padding:6rem 1.5rem;position:relative;overflow:hidden}
.founder-inner{max-width:52rem;margin:0 auto;position:relative;z-index:1}
.founder-inner h2{font-family:var(--serif);font-size:3rem;color:#292524;letter-spacing:-.02em;line-height:1.1;margin-bottom:2rem}
.founder-inner h2 em{font-style:italic;font-weight:400;color:var(--warm)}
.founder-text{color:#57534e;font-size:.95rem;line-height:1.75;font-weight:300}
.founder-text p+p{margin-top:1.5rem}
.founder-sig{margin-top:3rem;padding-top:2rem;border-top:1px solid rgba(214,211,209,.6);text-align:right}
.founder-sig .name{font-family:var(--serif);font-size:1.1rem;color:#292524;font-weight:500}
.founder-sig .role{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:var(--warm);margin-top:.25rem}

/* REVIEWS */
.reviews{background:var(--cream);padding:6rem 1.5rem;position:relative;overflow:hidden}
.rev-card{min-width:500px;max-width:500px;scroll-snap-align:start;background:#fff;border-radius:1.5rem;border:1px solid rgba(231,229,228,.6);padding:2rem;box-shadow:0 2px 8px rgba(0,0,0,.01);display:flex;flex-direction:column;justify-content:space-between}
.rev-stars{display:flex;gap:.25rem;margin-bottom:1.25rem}
.rev-star{color:#d4af37}
.rev-text{font-size:.875rem;color:#57534e;line-height:1.65;margin-bottom:1.5rem;font-weight:300}
.rev-footer{padding-top:1.25rem;border-top:1px solid #f5f5f4;display:flex;justify-content:space-between;align-items:center}
.rev-author .name{font-family:var(--serif);font-size:1rem;font-weight:600;color:#292524;display:block}
.rev-author .label{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:var(--warm)}
.rev-badge{font-size:9px;font-family:monospace;letter-spacing:.05em;color:#16a34a;background:#f0fdf4;padding:.25rem .75rem;border-radius:9999px;border:1px solid #bbf7d0;display:flex;align-items:center;gap:.35rem}
.rev-badge::before{content:'';width:.35rem;height:.35rem;border-radius:50%;background:#22c55e;display:inline-block}

/* CABINS */
.cabins{background:var(--sand);padding:3rem 1.5rem;border-top:1px solid rgba(214,211,209,.6)}
.cabins-header{text-align:center;max-width:48rem;margin:0 auto 3rem}
.cabins-header h2{font-family:var(--serif);font-size:3.5rem;color:#292524;letter-spacing:-.02em;margin-bottom:1.5rem}
.cabins-header p{font-size:.9rem;color:#78716c;font-weight:300;line-height:1.65}
.cabins-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2.5rem}
.cabin-card{background:#fff;border:1px solid rgba(231,229,228,.6);border-radius:2rem;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 8px 30px rgba(0,0,0,.015);transition:border-color .3s}
.cabin-card:hover{border-color:#d6d3d1}
.cabin-gallery{height:350px;position:relative;overflow:hidden;background:#f5f5f4}
.cabin-gallery img{width:100%;height:100%;object-fit:cover;transition:transform .7s}
.cabin-card:hover .cabin-gallery img{transform:scale(1.02)}
.cabin-gallery-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(12,10,9,.65),rgba(41,37,36,.1) 40%,transparent);pointer-events:none}
.cabin-arr{position:absolute;top:50%;transform:translateY(-50%);width:2.25rem;height:2.25rem;border-radius:50%;background:rgba(0,0,0,.3);border:none;color:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;transition:background .2s;z-index:2;font-size:1rem}
.cabin-arr:hover{background:rgba(0,0,0,.6)}
.cabin-arr.l{left:1rem}
.cabin-arr.r{right:1rem}
.cabin-dots{position:absolute;bottom:1.5rem;left:50%;transform:translateX(-50%);display:flex;gap:.375rem;z-index:2}
.cabin-dot{width:.375rem;height:.375rem;border-radius:50%;background:rgba(255,255,255,.5);transition:all .3s}
.cabin-dot.on{background:var(--warm);padding:0 .25rem;border-radius:.25rem}
.cabin-badge{position:absolute;top:1.5rem;left:1.5rem;z-index:2;padding:.375rem .875rem;background:var(--warm);color:#fff;font-family:monospace;font-size:9px;text-transform:uppercase;letter-spacing:.15em;font-weight:700;border-radius:9999px;display:flex;align-items:center;gap:.375rem}
.cabin-body{padding:2rem 2rem 0.75rem 2rem}
.cabin-body h3{font-family:var(--serif);font-size:1.75rem;color:#292524;margin-bottom:.75rem;transition:color .3s}
.cabin-card:hover .cabin-body h3{color:var(--warm)}
.cabin-body .desc{font-size:.875rem;color:#78716c;line-height:1.65;margin-bottom:1.5rem;font-weight:300}
.cabin-feats{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem}
.cabin-feat{display:flex;align-items:center;gap:.5rem;font-size:11px;color:#57534e;font-weight:300}
.cabin-feat svg{color:var(--warm);flex-shrink:0}
.cabin-footer{padding:0.75rem 2rem 2rem 2rem;border-top:1px solid #f5f5f4}
.cabin-price-row{display:flex;justify-content:space-between;padding:1.5rem 0}
.price-label{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:#a8a29e;margin-bottom:.25rem}
.price-nums{display:flex;align-items:baseline;flex-wrap:wrap;gap:.5rem}
.price-nums .amt{font-family:var(--serif);font-size:1.5rem;color:#292524}
.price-nums .per{font-size:.75rem;color:#a8a29e;font-weight:300}
.price-disc{font-family:var(--editorial);font-style:italic;font-size:11px;color:var(--warm);margin-top:.5rem}
.cabin-btns{display:grid;grid-template-columns:1fr 1fr;gap:.875rem}
.btn-outline{width:100%;padding:.75rem;border:1px solid #e7e5e4;color:#57534e;font-size:10px;text-transform:uppercase;letter-spacing:.2em;font-weight:500;border-radius:9999px;background:transparent;transition:all .3s}
.btn-outline:hover{border-color:#a8a29e;color:var(--warm);background:#fafaf9}
.btn-fill{width:100%;padding:.75rem;background:var(--warm);color:#fff;font-size:10px;text-transform:uppercase;letter-spacing:.2em;font-weight:600;border-radius:9999px;border:none;transition:all .3s;box-shadow:0 4px 12px rgba(164,144,124,.3)}
.btn-fill:hover{background:var(--warm-dark)}

/* BOOKING */
.booking{background:var(--cream);padding:3rem 1.5rem;border-top:1px solid rgba(214,211,209,.4)}
.booking-header{text-align:center;max-width:40rem;margin:0 auto 3rem}
.booking-header h2{font-family:var(--serif);font-size:3rem;color:#292524;letter-spacing:-.02em;margin-bottom:.75rem}
.booking-header p{font-size:.875rem;color:#78716c;font-weight:300;line-height:1.6}
.booking-grid{display:grid;grid-template-columns:7fr 5fr;gap:2.5rem;align-items:start;margin-bottom:5rem}
.form-panel{background:#fff;border-radius:2rem;padding:2.5rem;border:1px solid rgba(214,211,209,.8);box-shadow:0 4px 20px rgba(0,0,0,.04)}
.form-panel h3{font-family:var(--serif);font-size:1.5rem;color:#292524;margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem;color:#a4907c}
.form-panel h3 span{color:#292524}
.form-label{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.1em;color:#a8a29e;display:block;margin-bottom:.5rem;font-weight:600}
.cabin-sel-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem}
.cabin-opt{padding:1rem;border-radius:.75rem;border:1px solid #e7e5e4;text-align:left;background:transparent;width:100%;transition:all .2s}
.cabin-opt:hover{border-color:#a8a29e}
.cabin-opt.sel{border-color:#1c1917;background:#fafaf9}
.cabin-opt .cn{font-family:var(--serif);font-size:1rem;font-weight:500;color:#292524;display:block}
.cabin-opt .cc{font-size:.75rem;color:#78716c;font-weight:300;display:block;margin-top:.25rem}
.dates-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem}
.inp-wrap{position:relative}
.inp-wrap svg{position:absolute;left:.875rem;top:50%;transform:translateY(-50%);color:#a8a29e;pointer-events:none}
.inp{width:100%;padding:.75rem 1rem .75rem 2.75rem;background:#fafaf9;border:1px solid #e7e5e4;border-radius:.75rem;color:#57534e;font-size:.875rem;outline:none;font-family:var(--sans);transition:border-color .2s}
.inp:focus{border-color:#78716c}
.inp-plain{width:100%;padding:.75rem 1rem;background:#fafaf9;border:1px solid #e7e5e4;border-radius:.75rem;color:#57534e;font-size:.875rem;outline:none;font-family:var(--sans);transition:border-color .2s}
.inp-plain:focus{border-color:#78716c}
.contact-sec{border-top:1px solid #f5f5f4;padding-top:1.5rem;margin-top:1.5rem}
.contact-sec h4{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:#a8a29e;font-weight:700;margin-bottom:1rem}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem}
.btn-submit{width:100%;padding:1rem;background:#1c1917;color:var(--cream);font-size:11px;text-transform:uppercase;letter-spacing:.2em;font-weight:600;border:none;border-radius:.75rem;transition:background .3s}
.btn-submit:hover{background:#292524}
.form-note{margin-top:.75rem;padding:.75rem;background:#fafaf9;border-radius:.5rem;border:1px solid #f5f5f4;text-align:center}
.form-note p{font-size:11px;color:#a8a29e;font-weight:300}
.summary{background:#1c1917;color:var(--cream);border-radius:2rem;padding:2rem;border:1px solid rgba(255,255,255,.05);box-shadow:0 20px 60px rgba(0,0,0,.15)}
.summary .sum-label{font-size:9px;font-family:monospace;text-transform:uppercase;letter-spacing:.2em;color:#f5e6d3;display:block;margin-bottom:.5rem}
.summary h3{font-family:var(--serif);font-size:1.5rem;color:#fff;margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid rgba(255,255,255,.1)}
.sum-row{display:flex;justify-content:space-between;font-size:.875rem;color:rgba(255,255,255,.8);margin-bottom:1rem}
.sum-row .v{font-weight:500;color:#fff}
.sum-div{height:1px;background:rgba(255,255,255,.1);margin:1rem 0}
.sum-sub{font-size:.75rem;color:rgba(255,255,255,.6)}
.sum-sub .r{display:flex;justify-content:space-between;margin-bottom:.5rem}
.sum-sub .disc{color:#34d399;font-weight:500}
.sum-total{margin-top:2rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.1)}
.sum-total .lbl{font-size:11px;color:rgba(255,255,255,.5);font-family:monospace;text-transform:uppercase;letter-spacing:.15em}
.sum-total .amt{font-family:var(--serif);font-size:2rem;color:#f5e6d3;font-weight:700}
.sum-gift{margin-top:1rem;padding:.75rem;background:rgba(255,255,255,.05);border-radius:.75rem;border:1px solid rgba(255,255,255,.05);display:flex;align-items:flex-start;gap:.625rem}
.sum-gift .gt{font-weight:500;color:#fff;font-size:.8rem;display:block}
.sum-gift .gd{font-size:10px;color:rgba(255,255,255,.7);font-weight:300;line-height:1.5}
.plaques{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
.plaque-warm{background:#8e7a68;color:#fff;border-radius:1.5rem;padding:2rem;border:1px solid rgba(164,144,124,.45);min-height:180px;background-image:radial-gradient(circle at top right,rgba(255,255,255,.12),transparent 70%)}
.plaque-warm .e{font-size:9px;font-family:monospace;text-transform:uppercase;letter-spacing:.2em;color:#f5e6d3;display:block;margin-bottom:.5rem;font-weight:600}
.plaque-warm h4{font-family:var(--serif);font-size:1.5rem;color:#fff;margin-bottom:.625rem}
.plaque-warm p{font-size:.875rem;color:rgba(245,230,211,.85);font-weight:300;line-height:1.6}
.plaque-white{background:#fff;border-radius:1.5rem;padding:2rem;border:1px solid rgba(214,211,209,.8);min-height:180px}
.plaque-white .e{font-size:9px;font-family:monospace;text-transform:uppercase;letter-spacing:.2em;color:#a8a29e;display:block;margin-bottom:.5rem;font-weight:600}
.plaque-white h4{font-family:var(--serif);font-size:1.5rem;color:#292524;margin-bottom:.625rem}
.plaque-white p{font-size:.875rem;color:#57534e;font-weight:300;line-height:1.6}
.booking-success{display:none;padding:3rem;text-align:center}
.booking-success.show{display:block}
.succ-icon{width:4rem;height:4rem;background:#ecfdf5;color:#16a34a;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;border:1px solid #bbf7d0;font-size:1.5rem}
.booking-success h4{font-family:var(--serif);font-size:1.5rem;color:#292524;margin-bottom:.75rem}
.booking-success p{font-size:.875rem;color:#57534e;font-weight:300;line-height:1.6;max-width:28rem;margin:0 auto 1.5rem}
.btn-try{padding:.625rem 1.5rem;background:#f5f5f4;color:#57534e;font-size:11px;text-transform:uppercase;letter-spacing:.1em;font-weight:600;border:none;border-radius:9999px;transition:background .2s}
.btn-try:hover{background:#e7e5e4}

/* CARE */
.care{background:var(--sand);padding:6rem 1.5rem}
.care-header{text-align:center;max-width:40rem;margin:0 auto 4rem}
.care-header h2{font-family:var(--serif);font-size:3rem;color:#292524;letter-spacing:-.02em;margin-bottom:.75rem}
.care-header p{font-size:.875rem;color:#78716c;font-weight:300;line-height:1.6}
.care-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.care-card{background:#fff;border:1px solid rgba(231,229,228,.6);border-radius:1.5rem;padding:2rem;display:flex;flex-direction:column;justify-content:space-between;transition:all .3s;box-shadow:0 4px 20px rgba(0,0,0,.01)}
.care-card:hover{transform:translateY(-5px);border-color:rgba(164,144,124,.4)}
.care-icon{width:3rem;height:3rem;border-radius:.875rem;background:#fafaf9;border:1px solid #e7e5e4;display:flex;align-items:center;justify-content:center;color:var(--warm);margin-bottom:1rem;transition:all .3s}
.care-card:hover .care-icon{background:#1c1917;color:#fff}
.care-card h3{font-family:var(--serif);font-size:1.15rem;color:#292524;margin-bottom:.75rem;transition:color .3s}
.care-card:hover h3{color:var(--warm)}
.care-card p{font-size:.8rem;color:#78716c;line-height:1.6;font-weight:300}
.care-foot{margin-top:1.5rem;padding-top:1rem;border-top:1px solid #f5f5f4;display:flex;justify-content:space-between;font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:#a8a29e}
.care-foot .inc{color:var(--warm);font-weight:500;opacity:0;transition:opacity .3s}
.care-card:hover .inc{opacity:1}

/* TOURS */
.tours{background:var(--cream);padding:3rem 1.5rem;border-top:1px solid rgba(214,211,209,.4)}
.tours-header{text-align:center;max-width:48rem;margin:0 auto 3rem}
.tours-header h2{font-family:var(--serif);font-size:3rem;color:#292524;letter-spacing:-.02em;margin-bottom:.75rem}
.tours-header p{font-size:.875rem;color:#78716c;font-weight:300;line-height:1.6}
.tour-card{max-width:28rem;margin:0 auto;background:#fff;border-radius:2rem;border:1px solid rgba(231,229,228,.6);overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.02);transition:box-shadow .3s}
.tour-card:hover{box-shadow:0 8px 30px rgba(0,0,0,.06)}
.tour-img{height:240px;position:relative;overflow:hidden;background:#f5f5f4}
.tour-img img{width:100%;height:100%;object-fit:cover;transition:transform .7s}
.tour-card:hover .tour-img img{transform:scale(1.03)}
.tour-img-ov{position:absolute;inset:0;background:rgba(28,25,23,.2)}
.tour-badge{position:absolute;bottom:1rem;left:1rem;background:rgba(250,249,245,.9);backdrop-filter:blur(8px);padding:.375rem .75rem;border-radius:9999px;border:1px solid #e7e5e4;display:flex;align-items:center;gap:.375rem;font-size:10px;font-family:monospace;text-transform:uppercase;color:#44403c;font-weight:700;letter-spacing:.05em}
.tour-body{padding:1.5rem 2rem}
.tour-body h3{font-family:var(--serif);font-size:1.35rem;color:#292524;margin-bottom:1rem;transition:color .3s}
.tour-card:hover .tour-body h3{color:var(--warm)}
.tour-body p{font-size:.875rem;color:#57534e;font-weight:300;line-height:1.6;margin-bottom:1.5rem}
.tour-footer{padding-top:1.25rem;border-top:1px solid #f5f5f4;display:flex;justify-content:space-between;align-items:center}
.tour-loc{display:flex;align-items:center;gap:.5rem;font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:#a8a29e}
.tour-link{width:2rem;height:2rem;border-radius:50%;background:#f5f5f4;color:#1c1917;display:flex;align-items:center;justify-content:center;border:none;transition:all .3s;font-size:.8rem}
.tour-link:hover{background:var(--warm);color:#fff}

/* PRICELIST */
.pricelist{background:var(--cream);padding:3rem 1.5rem;border-top:1px solid rgba(214,211,209,.4)}
.price-box{max-width:48rem;margin:0 auto;background:#fff;border:1px solid rgba(231,229,228,.6);border-radius:2.25rem;padding:3.5rem;text-align:center;box-shadow:0 8px 30px rgba(0,0,0,.015);position:relative;overflow:hidden}
.price-icon{width:3.5rem;height:3.5rem;background:#fafaf9;border:1px solid #e7e5e4;border-radius:.875rem;display:flex;align-items:center;justify-content:center;color:var(--warm);margin:0 auto 1.5rem}
.price-box h2{font-family:var(--serif);font-size:3rem;color:#292524;letter-spacing:-.02em;margin-bottom:1rem}
.price-box p{font-size:.9rem;color:#78716c;font-weight:300;max-width:28rem;margin:0 auto 2.5rem;line-height:1.6}
.btn-dark{padding:1rem 2rem;background:#1c1917;color:#fff;font-size:11px;text-transform:uppercase;letter-spacing:.2em;font-weight:700;border:none;border-radius:9999px;transition:background .3s;display:inline-flex;align-items:center;gap:.5rem}
.btn-dark:hover{background:#292524}

/* FAQ */
.faq{background:var(--cream);padding:3rem 1.5rem;border-top:1px solid rgba(214,211,209,.4)}
.faq-inner{max-width:48rem;margin:0 auto}
.faq-header{text-align:center;max-width:40rem;margin:0 auto 4rem}
.faq-header h2{font-family:var(--serif);font-size:3rem;color:#292524;letter-spacing:-.02em}
.faq-list{display:flex;flex-direction:column;gap:1rem}
.faq-item{background:#fff;border:1px solid rgba(231,229,228,.6);border-radius:1rem;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.01)}
.faq-trigger{width:100%;text-align:left;padding:2rem;background:transparent;border:none;display:flex;align-items:center;justify-content:space-between;gap:1rem;font-family:var(--serif);font-size:1.1rem;color:#292524;transition:color .2s}
.faq-trigger:hover{color:var(--warm)}
.faq-ind{width:2rem;height:2rem;border-radius:50%;border:1px solid #e7e5e4;background:#fafaf9;color:#78716c;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .3s;font-size:1.1rem}
.faq-ind.open{background:#1c1917;color:#fff;border-color:#1c1917}
.faq-answer{max-height:0;overflow:hidden;transition:max-height .35s ease}
.faq-answer.open{max-height:500px}
.faq-answer-inner{padding:0 2rem 2rem;border-top:1px solid rgba(245,245,244,.5);padding-top:1.25rem;font-size:.875rem;color:#57534e;line-height:1.65;font-weight:300}
.faq-help{margin-top:3.5rem;padding:1.5rem;background:#fff;border-radius:.875rem;border:1px solid rgba(231,229,228,.6);text-align:center;display:flex;align-items:center;justify-content:center;gap:.75rem;box-shadow:0 2px 8px rgba(0,0,0,.01)}
.faq-help p{font-size:.875rem;color:#57534e;font-weight:300}
.faq-help a{font-weight:600;color:#1c1917;cursor:pointer}
.faq-help a:hover{text-decoration:underline}

/* MAP */
.map-sec{background:var(--cream);padding:3rem 1.5rem;border-top:1px solid rgba(214,211,209,.4);position:relative;overflow:hidden}
.map-header{text-align:center;max-width:40rem;margin:0 auto 4rem}
.map-header h2{font-family:var(--serif);font-size:3rem;color:#292524;letter-spacing:-.02em}
.map-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-bottom:4rem}
.map-card{background:#fff;border:1px solid rgba(231,229,228,.6);border-radius:2rem;padding:2rem;display:flex;flex-direction:column;justify-content:space-between;min-height:450px;box-shadow:0 8px 30px rgba(0,0,0,.015)}
.map-card .ce{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:var(--warm);display:block;margin-bottom:.5rem}
.map-card h3{font-family:var(--serif);font-size:1.75rem;color:#292524;margin-bottom:1rem}
.map-card p{font-size:.875rem;color:#78716c;font-weight:300;line-height:1.6;margin-bottom:1.5rem}
.map-frame{height:14rem;border-radius:1rem;overflow:hidden;border:1px solid rgba(214,211,209,.4);background:#f5f5f4;flex-shrink:0}
.map-frame iframe{width:100%;height:100%;border:none}
.tour-player{height:14rem;border-radius:1rem;overflow:hidden;background:#1c1917;flex-shrink:0;position:relative}
.tour-prev{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;cursor:pointer}
.tour-prev-bg{position:absolute;inset:0;background-size:cover;background-position:center;filter:brightness(.5);transition:transform .75s}
.tour-prev:hover .tour-prev-bg{transform:scale(1.05)}
.tour-play{width:4rem;height:4rem;border-radius:50%;background:var(--warm);color:#fff;display:flex;align-items:center;justify-content:center;border:none;z-index:1;transition:all .3s;font-size:1.5rem}
.tour-play:hover{background:#1c1917;transform:scale(1.1)}
.tour-play-lbl{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:rgba(250,249,245,.9);z-index:1}
.map-badge{display:flex;align-items:center;gap:.5rem;padding:.375rem .875rem;background:#fafaf9;border:1px solid #e7e5e4;border-radius:9999px;font-size:10px;font-family:monospace;text-transform:uppercase;color:var(--warm);align-self:flex-start}
.dir-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-bottom:6rem}
.dir-card{background:#fff;border:1px solid rgba(231,229,228,.6);border-radius:1rem;padding:1.5rem;box-shadow:0 4px 20px rgba(0,0,0,.01)}
.dir-card .de{font-size:9px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:var(--warm);display:block;margin-bottom:.5rem}
.dir-card .dt{font-size:.875rem;color:#292524;font-weight:500;margin-bottom:.375rem}
.dir-card .dd{font-size:.75rem;color:#78716c;font-weight:300;line-height:1.6}
.map-finale{text-align:center;max-width:48rem;margin:0 auto;padding-top:4rem;border-top:1px solid rgba(214,211,209,.6)}
.map-finale p{font-family:var(--editorial);font-style:italic;font-size:3rem;color:var(--warm);line-height:1.4;letter-spacing:.02em;font-weight:300;margin-bottom:2rem}
.btn-warm{padding:1rem 2rem;background:#1c1917;color:#fff;font-size:11px;text-transform:uppercase;letter-spacing:.25em;font-weight:700;border:none;border-radius:9999px;transition:all .3s;box-shadow:0 4px 12px rgba(164,144,124,.3)}
.btn-warm:hover{background:var(--warm-dark)}

/* FOOTER */
footer{background:var(--sand);color:#78716c;font-size:.75rem;padding:4rem 1.5rem;border-top:1px solid #e7e5e4}
.footer-inner{max-width:88rem;margin:0 auto;display:flex;flex-direction:column;gap:3rem}
.footer-top{display:grid;grid-template-columns:5fr 4fr 3fr;gap:2rem;align-items:start}
.footer-brand .bn{font-family:var(--serif);color:#292524;font-size:1.1rem;letter-spacing:.2em;text-transform:uppercase;display:block;margin-bottom:1rem}
.footer-brand p{font-size:11px;line-height:1.65;max-width:22rem;color:#a8a29e}
.footer-sec-ttl{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:#292524;font-weight:600;margin-bottom:.75rem;display:block}
.footer-contact{display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem;color:#57534e;transition:color .2s}
.footer-contact:hover{color:#1c1917}
.footer-contact svg{color:var(--warm);flex-shrink:0}
.footer-social{display:flex;align-items:center;gap:.625rem;margin-bottom:.625rem;color:#57534e;transition:color .2s}
.footer-social:hover{color:#1c1917}
.footer-soc-icon{width:1.5rem;height:1.5rem;border-radius:50%;background:#fff;border:1px solid #e7e5e4;display:flex;align-items:center;justify-content:center;color:var(--warm);flex-shrink:0}
.footer-div{height:1px;background:rgba(214,211,209,.6);width:100%}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;gap:1.5rem}
.footer-copy p{font-size:10px;color:#a8a29e;font-family:monospace;line-height:1.5}
.footer-right{display:flex;align-items:center;gap:1.5rem}
.btn-privacy{font-size:11px;color:#78716c;display:flex;align-items:center;gap:.375rem;transition:color .2s;background:transparent;border:none}
.btn-privacy:hover{color:#1c1917}
.btn-privacy svg{color:var(--warm)}
.btn-top{width:2rem;height:2rem;border-radius:50%;border:1px solid #e7e5e4;background:transparent;color:#57534e;display:flex;align-items:center;justify-content:center;transition:all .3s;font-size:.8rem}
.btn-top:hover{border-color:#a8a29e;background:#f5f5f4}

/* MODALS */
.modal{position:fixed;inset:0;background:rgba(12,10,9,.6);backdrop-filter:blur(6px);z-index:100;display:none;align-items:flex-start;justify-content:center;padding:1.5rem 1rem;overflow-y:auto;-webkit-overflow-scrolling:touch}
.modal.open{display:flex}
.modal-box{background:var(--cream);border-radius:2rem;overflow:hidden;border:1px solid #e7e5e4;z-index:101;width:100%;max-width:52rem;position:relative;box-shadow:0 25px 80px rgba(0,0,0,.25);margin:0 auto}
.modal-close{position:absolute;top:1rem;right:1rem;width:2.5rem;height:2.5rem;border-radius:50%;background:rgba(28,25,23,.5);color:#fff;border:none;display:flex;align-items:center;justify-content:center;z-index:5;transition:background .2s;font-size:1rem}
.modal-close:hover{background:#1c1917}
/* CABIN GALLERY: фото без обрезания */
.cabin-gallery-modal{
  background:#1a1512;
  overflow:hidden;
  height:380px;
  position:relative;
}
@media(max-width:600px){.cabin-gallery-modal{height:240px}}
/* Один img — занимает весь контейнер, фото целиком с чёрными полосами */
#cm-img{
  position:absolute;
  top:0; left:0;
  width:100%; height:100%;
  object-fit:contain;
  display:block;
  background:#1a1512;
  transition:opacity .3s ease;
}
/* Заголовок под фото — не поверх него */
.cabin-modal-title-row{
  padding:1.25rem 2rem .5rem;
  display:flex;
  align-items:center;
  gap:.75rem;
  flex-wrap:wrap;
  background:var(--cream)
}
.cabin-modal-title-row h3{
  font-family:var(--serif);
  font-size:1.75rem;
  color:#292524;
  margin:0;
  flex:1
}
.cabin-modal-badge{
  padding:.375rem .875rem;
  background:var(--warm);
  color:#fff;
  font-family:monospace;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.15em;
  font-weight:700;
  border-radius:9999px;
  white-space:nowrap
}
/* Точки поверх фото — внизу */
.cm-dots-over{
  position:absolute;
  bottom:.75rem;
  left:50%;
  transform:translateX(-50%);
  display:flex;
  gap:.375rem;
  z-index:3;
  pointer-events:none;
}
.cm-dots-over span{pointer-events:all;}
.cm-arr-modal{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  width:2.25rem;
  height:2.25rem;
  border-radius:50%;
  background:rgba(0,0,0,.4);
  border:none;
  color:#fff;
  font-size:1.2rem;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  z-index:3;
  transition:background .2s;
  line-height:1;
}
.cm-arr-modal:hover{background:rgba(0,0,0,.7)}
.cm-arr-modal.l{left:.75rem}
.cm-arr-modal.r{right:.75rem}

/* Старые modal-cover правила — оставляем для svc-modal */
.modal-cover{height:20rem;position:relative}
.modal-cover img{width:100%;height:100%;object-fit:cover}
.modal-cover-grad{position:absolute;inset:0;background:linear-gradient(to top,#1c1917,transparent)}
.modal-cover-title{position:absolute;bottom:1.5rem;left:1.5rem;font-family:var(--serif);font-size:1.75rem;color:#fff}
.modal-content{padding:2rem;max-height:92vh;overflow-y:auto}
.modal-content p{font-size:.875rem;color:#44403c;line-height:1.7;margin-bottom:1.5rem}
.modal-sec-lbl{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.15em;color:var(--warm);margin-bottom:.75rem;display:flex;align-items:center;gap:.375rem;font-weight:700}
.modal-specs{list-style:none;display:flex;flex-direction:column;gap:.625rem}
.modal-spec{display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#57534e;font-weight:300}
.spec-dot{width:.375rem;height:.375rem;border-radius:50%;background:var(--warm);margin-top:.45rem;flex-shrink:0}
.modal-footer{padding:1.5rem 2rem;border-top:1px solid #e7e5e4;display:flex;justify-content:flex-end}
.btn-modal{padding:.625rem 1.5rem;background:#1c1917;color:#fff;font-size:10px;text-transform:uppercase;letter-spacing:.15em;font-weight:600;border:none;border-radius:9999px;transition:background .2s}
.btn-modal:hover{background:#292524}
  
/* CABIN MODAL */
.cabin-modal-box{max-width:42rem}
.cabin-modal-content{padding:2rem}
.cabin-feat-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem}
.cabin-feat-item{display:flex;align-items:flex-start;gap:.625rem;font-size:.875rem;color:#44403c;font-weight:300}
.kitchen-box{background:#fafaf9;border:1px solid rgba(231,229,228,.6);border-radius:.875rem;padding:1.25rem 1.5rem}
.kitchen-head{display:flex;align-items:center;gap:.75rem;color:var(--warm);margin-bottom:.75rem;font-family:var(--serif);font-size:1.1rem;color:#292524}
.kitchen-box p{font-size:.8rem;color:#78716c;font-weight:300;line-height:1.6}
.cabin-modal-footer{padding:1.5rem 2rem;border-top:1px solid rgba(231,229,228,.6);display:flex;justify-content:space-between;align-items:center;gap:1rem}
.cabin-modal-footer .offer{font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.1em;color:#a8a29e}
.cabin-modal-footer .offer em{font-style:italic;font-family:var(--editorial);font-size:.875rem;color:var(--warm);display:block;text-transform:none;letter-spacing:0}
.cabin-modal-btns{display:flex;gap:.75rem}
.btn-cancel{padding:.75rem 1.25rem;border:1px solid #e7e5e4;color:#57534e;font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:600;border-radius:9999px;background:transparent;transition:all .2s}
.btn-cancel:hover{background:#fafaf9;color:#1c1917}
.btn-book{padding:.75rem 1.5rem;background:var(--warm);color:#fff;font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:700;border:none;border-radius:9999px;transition:all .3s;display:flex;align-items:center;gap:.375rem}
.btn-book:hover{background:#1c1917}

/* PRICE MODAL */
.price-modal-box{max-width:48rem;background:#fff}
.price-modal-hdr{padding:2rem}
.price-modal-wrap{padding:0 2rem;overflow-x:auto;max-height:50vh}
.price-tbl{width:100%;border-collapse:collapse;min-width:400px}
.price-tbl thead tr{border-bottom:1px solid #e7e5e4}
.price-tbl thead th{padding:1rem 0;font-size:10px;font-family:monospace;text-transform:uppercase;letter-spacing:.1em;color:var(--warm);font-weight:600}
.price-tbl thead th:not(:first-child){text-align:right}
.price-tbl tbody tr{border-bottom:1px solid #f5f5f4;transition:background .15s}
.price-tbl tbody tr:hover{background:#fafaf9}
.price-tbl td{padding:1rem .5rem;font-size:.875rem;font-weight:300;color:#57534e}
.price-tbl td:first-child{font-family:var(--serif);color:#292524;font-weight:400}
.price-tbl td:nth-child(2){text-align:right;color:var(--warm);font-weight:500;white-space:nowrap}
.price-tbl td:nth-child(3){text-align:right;font-size:.75rem;color:#a8a29e;font-style:italic}
.price-modal-foot{padding:1.5rem 2rem;background:#fafaf9;border-top:1px solid #f5f5f4;display:flex;justify-content:space-between;align-items:center;gap:1rem}
.price-modal-note{display:flex;align-items:center;gap:.5rem;font-size:.75rem;color:var(--warm);font-weight:500}

@keyframes panorama{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* Responsive */
@media(max-width:1024px){
  .terr-grid{grid-template-columns:1fr}
  .svc-grid{grid-template-columns:repeat(2,1fr)}
  .cabins-grid{grid-template-columns:1fr}
  .booking-grid{grid-template-columns:1fr}
  .care-grid{grid-template-columns:repeat(2,1fr)}
  .map-grid{grid-template-columns:1fr}
  .footer-top{grid-template-columns:1fr 1fr}
  .plaques{grid-template-columns:1fr}
  .dir-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:768px){
  .navbar{padding:1.5rem 1.5rem}
  .hero h1{font-size:4.2rem}
  .hero-loc{left:1.5rem;top:5.5rem}
  .sec-header-row{flex-direction:column;align-items:flex-start;gap:1.5rem}
  .sec-header-row .left h2{font-size:2.5rem}
  .scen-card{min-width:340px;max-width:340px}
  .scen-img{height:280px}
  .svc-grid{grid-template-columns:1fr}
  .rev-card{min-width:320px;max-width:100%}
  .care-grid{grid-template-columns:1fr}
  .plaques{grid-template-columns:1fr}
  .cabin-btns{grid-template-columns:1fr}
  .contact-grid{grid-template-columns:1fr}
  .dates-grid{grid-template-columns:1fr}
  .cabin-sel-grid{grid-template-columns:1fr}
  .footer-top{grid-template-columns:1fr}
  .footer-bottom{flex-direction:column;text-align:center}
  .dir-grid{grid-template-columns:1fr}
  .scroll-tip{display:block}
  .h2-muted{font-size:2.2rem}
  .map-finale p{font-size:2rem}
}

/* ===== НОВЫЙ КОД ДЛЯ АТМОСФЕРНОГО БЛОКА ===== */
@media (max-width: 768px) {
  .video-grid {
    display: flex !important;
    flex-direction: column !important;
    gap: 2.5rem !important;
  }
  .video-container {
    max-width: 100% !important;
  }
  .video-container video {
    aspect-ratio: 1/1 !important;
    width: 100% !important;
    height: 280px !important;
    object-fit: cover !important;
  }
  .video-grid > div {
    order: 2 !important; /* текст после видео */
  }
  .video-grid > .video-container {
    order: 1 !important; /* видео перед текстом */
  }
}
/* ===== НОМЕР ТЕЛЕФОНА НА МОБИЛЬНЫХ ===== */
@media (max-width: 768px) {
  .hero-phone {
    top: 0.75rem !important;
    right: 0.75rem !important;
    font-size: 13px !important;
    opacity: 0.85;
  }
}

/* ===== ФОТО В МОДАЛКАХ УСЛУГ ===== */
/* На мобиле — 72% ширины: видно фото + краешек следующего */
@media (max-width: 768px) {
  #sm-desc > div > div[style*="flex"] {
    flex: 0 0 72% !important;
    max-width: 72% !important;
  }
}
  /* ===== СКРЫВАЕМ НОМЕР НА МОБИЛЬНЫХ ===== */
@media (max-width: 768px) {
  .desktop-only {
    display: none !important;
  }
}
  /* ===== АДАПТАЦИЯ ДЛЯ ФИНАЛЬНОГО БЛОКА НА МОБИЛЬНЫХ ===== */
@media (max-width: 768px) {
  .map-finale p {
    font-size: 1.6rem !important;
    padding: 0 1rem;
  }
  .map-finale {
    min-height: 280px !important;
  }
  .map-finale > div[style*="position:relative;z-index:2"] {
    padding: 3rem 1.5rem !important;
    min-height: 280px !important;
  }
}
  /* Чайный уголок и связь — единый светлый тёплый фон */
.plaque-warm,
.plaque-white {
  background: #faf3eb !important;
}
</style>
</head>
<body>

<nav class="navbar">
  <div class="logo-wrap" style="gap:1rem;">
    <div class="logo-img" style="width:4rem;height:4rem;">
      <img src="images/logo.jpg" alt="Горная Усадьба">
    </div>
    <span class="logo-name" style="font-size:14px;letter-spacing:0.2em;">Горная Усадьба</span>
  </div>
  
</nav>

<section class="hero">
  <div class="hero-bg">
    <div class="hero-overlay"></div>
    <img src="images/head.jpg" alt="Горная Усадьба">
  </div>
   <a href="tel:+79280302070" class="desktop-only" style="position:absolute;top:2rem;right:4rem;z-index:3;font-size:20px;font-weight:300;color:#f5e6d3;text-decoration:none;letter-spacing:0.05em;transition:color 0.3s;font-family:var(--sans);">
  +7-928-030-20-70
</a>
  <div class="hero-loc">
    <span class="l1">Горный Алтай,</span>
    <span class="l2">в горах Алтая</span>
  </div>
  <div class="hero-content">
    <h1>Место, где<br><em>отдыхают</em><br>душой</h1>
    <p class="hero-sub">Приезжайте за тишиной, уютом <br>и вечерами у костра</p>
    <div class="hero-btns">
      <button class="btn-glass" onclick="goto('booking')">Забронировать домик</button>
      <button class="btn-glass btn-glass-outline" onclick="goto('scenarios')">Ощутить атмосферу</button>
    </div>
  </div>
</section>

<section class="impression" id="impression">
  <div class="imp-glow tl"></div>
  <div class="imp-glow br"></div>
  <div class="sec-inner">
    <div class="title-center"><h2 class="h2-muted">Первое впечатление</h2></div>
    <div class="imp-quote">
      <p>«Представьте: вы собрали вещи, настроились и едете с близкими на отдых. Расслабиться, отдохнуть, побыть вместе. Вся суета, все дела остаются в городе. Эти дни - только для вас».</p>
      <div class="imp-divider"></div>
    </div>
    <div class="imp-banner">
      <div class="imp-img-wrap" style="position:relative;">
        <img src="images/1.jpg" alt="Дорога в Горную Усадьбу">
        
        <!-- БЕЛЫЙ ТУМАН ПО УГЛАМ -->
        <div style="position:absolute;top:0;left:0;width:30%;height:30%;background:radial-gradient(circle at top left, rgba(255,255,255,0.2), transparent 90%);pointer-events:none;z-index:2;"></div>
<div style="position:absolute;top:0;right:0;width:30%;height:30%;background:radial-gradient(circle at top right, rgba(255,255,255,0.15), transparent 90%);pointer-events:none;z-index:2;"></div>
<div style="position:absolute;bottom:0;left:0;width:30%;height:30%;background:radial-gradient(circle at bottom left, rgba(255,255,255,0.15), transparent 90%);pointer-events:none;z-index:2;"></div>
<div style="position:absolute;bottom:0;right:0;width:30%;height:30%;background:radial-gradient(circle at bottom right, rgba(255,255,255,0.2), transparent 90%);pointer-events:none;z-index:2;"></div>
        <span class="imp-caption">дорога к горной усадьбе</span>
      </div>
    </div>
    <div class="imp-text">
      <p>Вы сворачиваете с трассы на лесную дорогу. Суета города остаётся позади.</p>
      <p>И вот вы подъезжаете к Усадьбе. Ещё не выйдя из машины, опускаете стекло - и слышите тишину. Настоящую. Такую, которая сначала непривычна, а потом - не хочешь, чтобы она заканчивалась. Вдыхаете целебный лесной воздух. И понимаете: вы там, где должны быть.</p>
      <p>Закрываете дверь машины - и словно оставляете за ней всё: дела, звонки, бесконечный список задач. Перед вами - дорога к домику, на горизонте - гора и озеро. Вы идёте не спеша. Вдыхаете запах леса.</p>
      <p>Вас встречает радушная хозяйка. Провожает в ваш домик. Вы переступаете порог - и сразу ощущаете: здесь вы сможете отдохнуть по-настоящему. С комфортом. С удовольствием от каждого мгновения.</p>
      <p>Вы никуда не спешите. И всё время - ваше. Никаких дел. Никаких забот. Только отдых.</p>
      <p>Вечером вы сидите у костра. Рядом - ваши близкие. А утром вы проснётесь в тишине, а не под будильник. И это будет лучшее утро за долгое время.</p>
      <p>Вот вы уже по-настоящему отдохнули. А впереди - ещё день. Или даже несколько. Время принадлежит только вам. Отдых, где всё - для вас.</p>
      <div class="imp-finale"><p>Это не сказка. Это Горная Усадьба.</p></div>
    </div>
  </div>
</section>

<section class="scenarios" id="scenarios">
  <div class="sec-inner-wide">
    <div class="sec-header-row">
      <div class="left">
        <p>Идеальный день в Горной Усадьбе</p>
        <h2>Сценарии вашего отдыха</h2>
      </div>
    
    </div>
    <div class="h-scroll" id="ss"></div>
    <p class="scroll-tip">← Листайте вправо или влево →</p>
  </div>
</section>

<section class="services" id="services">
  <div class="sec-inner-wide">
    <div class="territory-intro" style="display:none;">
  <span class="eyebrow">О нашей усадьбе</span>
  <h2>Естественная красота природы и продуманный комфорт</h2>
</div>
    <div class="terr-grid">
      <div class="terr-img"><img src="images/territory.jpg" alt="Территория Горной Усадьбы" loading="lazy"></div>
      <div class="terr-text">
        <span class="eyebrow eyebrow-warm">Территория</span>
        <p class="lead">Уютная база отдыха в живописном месте. Вокруг - лес, чистый воздух.</p>
        <div class="terr-divider"></div>
        <p class="body">Рядом - пруд, вид на горы и река Зеленчук. Ухоженная территория с хвойными саженцами.</p>
      </div>
    </div>
    <div class="svc-header">
      <span class="eyebrow">Наши услуги</span>
      <h2>Всё для вашего отдыха</h2>
    </div>
    <div class="svc-grid" id="svc-grid"></div>
    <div class="silence">
      <div class="silence-icon">⚠</div>
      <div class="silence-text">
        <h3>Тишина и покой</h3>
        <p>Громкая музыка и шумные вечеринки у нас запрещены. Мы оберегаем спокойный отдых каждого нашего гостя.</p>
      </div>
    </div>
  </div>
</section>

<section class="founder" id="manifesto">
  <div class="founder-inner">
    <h2>Манифест <br><em>основателя</em></h2>
    <div class="founder-text">
      <p>Это место родилось из простого желания - дать своей семье тишину, уединение и возможность спокойно проводить время вместе. А потом я понял: это нужно не только моей семье.</p>
      <p>Многое здесь сделано вручную - детали, которые вы обязательно заметите при заезде, я придумал и смастерил сам. Так я хотел передать тепло, которое нельзя купить, его можно только ощутить, находясь здесь.</p>
      <p>Мне хотелось, чтобы здесь сочетались уединение на природе и комфорт, к которому вы привыкли.</p>
      <p>Мне важно, чтобы вы уехали отдохнувшими и с новыми силами. Репутация для меня - это когда люди советуют это место своим близким.
</p>
      <p> Если вы цените природу, тишину и хотите отдохнуть душой - приезжайте. Здесь вам будут рады.</p>
    </div>
    <div class="founder-sig">
      <p class="name">Александр</p>
      <p class="role">Основатель Горной Усадьбы</p>
    </div>
  </div>
</section>
  
<section class="reviews" id="reviews">
  <div class="sec-inner-wide">
    <div class="sec-header-row">
      <div class="left">
        <span class="eyebrow">Душевные отзывы</span>
        <h2>Что чувствуют наши гости</h2>
      </div>
      <div class="nav-arrows">
        <button class="nav-arr" onclick="hs('rs',-500)">&#8592;</button>
        <button class="nav-arr" onclick="hs('rs',500)">&#8594;</button>
      </div>
    </div>
    <div class="h-scroll" id="rs"></div>
    <p class="scroll-tip">← Проведите пальцем →</p>
  </div>
</section>

<section class="cabins" id="cabins">
  <div class="sec-inner-wide">
    <div class="cabins-header">
      <h2>Выберите ваш домик</h2>
      <p>Посмотрите наши домики и выберите тот, который вам по душе. Каждый из них оснащен всем необходимым для комфортной жизни.</p>
    </div>
    <div class="cabins-grid" id="cabins-grid"></div>
  </div>
</section>
  <!-- ===== АТМОСФЕРНЫЙ БЛОК ===== -->
<style>
  @keyframes riseSpark {
    0% { transform: translateY(0px) scale(1) rotate(0deg); opacity: 0; }
    15% { opacity: var(--spark-opacity, 0.7); }
    50% { transform: translateY(-200px) translateX(var(--drift-medium, 15px)) scale(1.1) rotate(180deg); filter: blur(0.3px); }
    100% { transform: translateY(-450px) translateX(var(--drift-max, 30px)) scale(0.5) rotate(360deg); opacity: 0; }
  }
  .video-play-btn {
    transition: opacity 0.3s ease;
  }
  .video-container:hover .video-play-btn {
    opacity: 1;
  }
  .atmosphere-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .atmosphere-grid .video-wrapper {
    max-width: 480px;
    width: 100%;
  }
  @media (max-width: 768px) {
    .atmosphere-grid {
      display: flex !important;
      flex-direction: column !important;
      gap: 2.5rem !important;
    }
    .atmosphere-grid .video-wrapper {
      max-width: 100% !important;
      order: 1 !important; /* ← ВИДЕО СВЕРХУ! */
    }
    .atmosphere-grid .video-wrapper video {
      aspect-ratio: 1/1 !important;
      height: auto !important;
    }
    .atmosphere-grid .text-block {
      text-align: center !important;
      order: 2 !important; /* ← ТЕКСТ СНИЗУ! */
    }
  }
</style>

<div style="background:#EAE5DE;padding:0 0 4rem 0;overflow:hidden;">

  <!-- ШАПКА: ФОТО ОЧАГА -->
  <div style="position:relative;overflow:hidden;margin-bottom:4rem;height:400px;border-bottom:1px solid rgba(168,162,158,0.3);box-shadow:0 20px 60px rgba(0,0,0,0.05);">
    <div style="position:absolute;inset:0;background:rgba(28,25,23,0.2);z-index:10;"></div>
    <img src="images/очаг.jpg" alt="Вечер у кострового очага" style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;filter:brightness(0.85);">
    <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:3rem;z-index:30;text-align:center;padding-left:1.5rem;padding-right:1.5rem;">
      <p style="font-family:var(--editorial);font-style:italic;font-size:2rem;color:#fff;text-shadow:0 2px 40px rgba(0,0,0,0.5);margin:0;letter-spacing:-0.02em;line-height:1.2;">Вечера, которые запоминаются</p>
      <div style="width:4rem;height:1px;background:rgba(255,255,255,0.3);margin:1.2rem auto;"></div>
      <p style="font-family:var(--sans);font-size:0.85rem;color:rgba(255,255,255,0.9);letter-spacing:0.2em;text-transform:uppercase;font-weight:300;margin:0;">Огонь • Уют • Тишина</p>
    </div>
  </div>

  <!-- ===== ШАХМАТКА ===== -->
  <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;">

    <!-- 1. ВИДЕО ОГНЯ (слева) + ТЕКСТ (справа) -->
    <div class="atmosphere-grid" style="margin-bottom:4rem;">
      <div class="video-wrapper video-container" style="position:relative;border-radius:2rem;overflow:hidden;background:#e8e3da;box-shadow:0 8px 30px rgba(0,0,0,0.06);cursor:pointer;justify-self:end;">
        <video loop muted playsinline poster="images/ogon.png" style="width:100%;display:block;aspect-ratio:1/1;object-fit:cover;">
          <source src="images/ogon.mp4" type="video/mp4">
        </video>
        <div class="video-play-btn" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;opacity:1;transition:opacity 0.3s;">
          <div style="width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,0.3);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#292524"><polygon points="5,3 19,12 5,21" /></svg>
          </div>
        </div>
      </div>
      <div class="text-block">
        <p style="font-family:var(--serif);font-size:2rem;color:#292524;margin:0 0 0.75rem 0;letter-spacing:-0.02em;line-height:1.2;">У костра</p>
        <p style="font-family:var(--sans);font-size:1rem;color:#78716c;font-weight:300;line-height:1.8;margin:0;">Огонь согревает, тишина успокаивает. Вечер у костра — время для душевных разговоров.</p>
      </div>
    </div>

    <!-- 2. ТЕКСТ (слева) + ВИДЕО УСАДЬБЫ (справа) -->
    <div class="atmosphere-grid" style="margin-bottom:4rem;">
      <div class="text-block">
        <p style="font-family:var(--serif);font-size:2rem;color:#292524;margin:0 0 0.75rem 0;letter-spacing:-0.02em;line-height:1.2;">Вечерняя усадьба</p>
        <p style="font-family:var(--sans);font-size:1rem;color:#78716c;font-weight:300;line-height:1.8;margin:0;">Теплый вечер и уютный свет домиков. Здесь время ощущается медленнее.</p>
      </div>
      <div class="video-wrapper video-container" style="position:relative;border-radius:2rem;overflow:hidden;background:#e8e3da;box-shadow:0 8px 30px rgba(0,0,0,0.06);cursor:pointer;justify-self:start;">
        <video loop muted playsinline poster="images/domiki.png" style="width:100%;display:block;aspect-ratio:1/1;object-fit:cover;">
          <source src="images/domiki.mp4" type="video/mp4">
        </video>
        <div class="video-play-btn" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;opacity:1;transition:opacity 0.3s;">
          <div style="width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,0.3);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#292524"><polygon points="5,3 19,12 5,21" /></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. ВИДЕО БАССЕЙНА (слева) + ТЕКСТ (справа) -->
    <div class="atmosphere-grid">
      <div class="video-wrapper video-container" style="position:relative;border-radius:2rem;overflow:hidden;background:#e8e3da;box-shadow:0 8px 30px rgba(0,0,0,0.06);cursor:pointer;justify-self:end;">
        <video loop muted playsinline poster="images/bass.png" style="width:100%;display:block;aspect-ratio:1/1;object-fit:cover;">
          <source src="images/bass.mp4" type="video/mp4">
        </video>
        <div class="video-play-btn" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;opacity:1;transition:opacity 0.3s;">
          <div style="width:60px;height:60px;border-radius:50%;background:rgba(255,255,255,0.3);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#292524"><polygon points="5,3 19,12 5,21" /></svg>
          </div>
        </div>
      </div>
      <div class="text-block">
        <p style="font-family:var(--serif);font-size:2rem;color:#292524;margin:0 0 0.75rem 0;letter-spacing:-0.02em;line-height:1.2;">Отдых в бассейне</p>
        <p style="font-family:var(--sans);font-size:1rem;color:#78716c;font-weight:300;line-height:1.8;margin:0;">Вода с расслабляющей подсветкой. Звездное небо над головой. Темные силуэты гор. Здесь кажется, что жизнь удалась.</p>
      </div>
    </div>

  </div>

</div>

<script>
  document.querySelectorAll('.video-container').forEach(function(container) {
    container.addEventListener('click', function() {
      var video = this.querySelector('video');
      var btn = this.querySelector('.video-play-btn');
      if (video.paused) {
        video.play();
        if (btn) btn.style.opacity = '0';
      } else {
        video.pause();
        if (btn) btn.style.opacity = '1';
      }
    });
  });
</script>
<section class="booking" id="booking">
  <div class="sec-inner-wide">
    <div class="booking-header">
