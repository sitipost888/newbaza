          <style>
            div[style*="overflow-x: auto"]::-webkit-scrollbar { height: 2px; }
            div[style*="overflow-x: auto"]::-webkit-scrollbar-track { background: #f0f0f0; border-radius: 10px; }
            div[style*="overflow-x: auto"]::-webkit-scrollbar-thumb { background: #a4907c; border-radius: 10px; }
            div[style*="overflow-x: auto"]::-webkit-scrollbar-thumb:hover { background: #8e7a68; }
          </style>
          <div style="flex: 0 0 45%; max-width: 45%; scroll-snap-align: start; border-radius: 1rem; overflow: hidden;">
            <img src="images/караоке2.jpg" alt="Караоке 1" style="width:100%; display:block;">
          </div>
          <div style="flex: 0 0 45%; max-width: 45%; scroll-snap-align: start; border-radius: 1rem; overflow: hidden;">
            <img src="images/караоке4.jpg" alt="Караоке 2" style="width:100%; display:block;">
          </div>
          <div style="flex: 0 0 45%; max-width: 45%; scroll-snap-align: start; border-radius: 1rem; overflow: hidden;">
            <img src="images/караоке5.jpg" alt="Караоке 3" style="width:100%; display:block;">
          </div>
          <div style="flex: 0 0 45%; max-width: 45%; scroll-snap-align: start; border-radius: 1rem; overflow: hidden;">
            <img src="images/караоке6.jpg" alt="Караоке 4" style="width:100%; display:block;">
          </div>
          <div style="flex: 0 0 45%; max-width: 45%; scroll-snap-align: start; border-radius: 1rem; overflow: hidden;">
            <img src="images/караоке7.jpg" alt="Караоке 5" style="width:100%; display:block;">
          </div>
        </div>

        <p>Помещение для караоке расположено на втором этаже над банным комплексом и имеет собственный выход на балкон, что идеально подходит для отдыха больших компаний.</p>
        
        <p>Репертуар караоке состоит из 50 тысяч песен. Он обновляется и еженедельно добавляется до 300–500 новых песен.</p>
        
                <p>Гостям мы предлагаем здесь большой вместительный диван, телевизор с диагональю 75 дюймов, современную акустическую систему, цветную иллюминацию, а для детей здесь оборудована игровая зона с аэрохоккеем.</p>
      </div>
    </div>
    `;
  } else if (id === 5) {
    content = `<p>ТЕКСТ ДЛЯ МАНГАЛА</p>`;
  } else if (id === 6) {
    content = `<p>ТЕКСТ ДЛЯ САПБОРДОВ</p>`;
  } else {
    content = `<p>${s.description}</p>`;
  }
  
  document.getElementById('sm-desc').innerHTML = content;
  openM('svc-modal');
}

// Close modal on overlay click
['svc-modal','cabin-modal','price-modal'].forEach(id=>{
  document.getElementById(id).addEventListener('click',function(e){if(e.target===this)closeM(id)});
});
  // ===== ВКЛЮЧАЕМ/ВЫКЛЮЧАЕМ ВИДЕО ПО КЛИКУ =====
document.querySelectorAll('.video-container').forEach(function(container) {
  container.addEventListener('click', function() {
    var video = this.querySelector('video');
    var btn = this.querySelector('.play-btn');
    if (video.paused) {
      video.play();
      btn.style.opacity = '0';
    } else {
      video.pause();
      btn.style.opacity = '1';
    }
  });
});

  // ===== ПОКАЗЫВАЕМ «ВКЛЮЧЕНО В ОТДЫХ» ПРИ КАСАНИИ НА МОБИЛЬНЫХ =====
document.querySelectorAll('.care-card').forEach(function(card) {
  card.addEventListener('touchstart', function() {
    var inc = this.querySelector('.inc');
    if (inc) {
      inc.style.opacity = '1';
      setTimeout(function() {
        inc.style.opacity = '0';
      }, 1500);
    }
  });
});


</script>
</body>
</html>
