    </div>

</section>

<!-- ЧАЙНЫЙ УГОЛОК + СВЯЗЬ — единый тёплый фон -->
<section style="background:#ede8e0;padding:3rem 1.5rem 3.5rem;">
  <div style="max-width:42rem;margin:0 auto;display:flex;flex-direction:column;gap:1.5rem;">

    <!-- Чайный уголок -->
    <div class="plaque-warm" style="background:#f0e9df;border:1px solid rgba(164,144,124,0.25);">
      <span class="e" style="color:#8e7a68;">Подарок при заезде</span>
      <h4 style="color:#292524;">Атмосферный чайный уголок</h4>
      <p style="color:#57534e;">Каждому гостю мы дарим ароматный горный чай из местных целебных трав, домашнее варенье и натуральный мед.</p>
    </div>

    <!-- Связь -->
    <div class="plaque-white" style="background:#ffffff;border:1px solid rgba(164,144,124,0.2);">
      <span class="e">Связь и комфорт</span>
      <h4>Надежная связь и интернет</h4>
      <p>На всей территории усадьбы работает стабильный интернет и уверенный мобильный сигнал — чтобы вы были на связи, когда нужно, и могли полностью отключиться, когда захочется.</p>
    </div>

  </div>
</section>

<section class="care" id="care">
  <div class="sec-inner-wide">
