// UTILS
function goto(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth'})}
function hs(id,amt){document.getElementById(id)?.scrollBy({left:amt,behavior:'smooth'})}
function openM(id){document.getElementById(id).classList.add('open');document.body.style.overflow='hidden'}
function closeM(id){
  document.getElementById(id).classList.remove('open');
  document.body.style.overflow = '';
  const smDesc = document.getElementById('sm-desc');
  const smImg = document.getElementById('sm-img');
  const smTitle = document.getElementById('sm-title');
  if(smDesc) smDesc.innerHTML = '';
  if(smImg) smImg.src = '';
  if(smTitle) smTitle.textContent = '';
}

// RENDER SCENARIOS
const ss=document.getElementById('ss');
scenarios.forEach(s=>{
  ss.innerHTML+=`<div class="scen-card"><div class="scen-img"><div class="scen-img-ov"></div><img src="${s.image}" alt="${s.title}" loading="lazy" style="filter:brightness(0.98) saturate(0.95);"><span class="scen-num">0${s.id}</span></div><div class="scen-body"><h3>${s.title}</h3><p>${s.description}</p></div></div>`;
});

// RENDER SERVICES
const sg = document.getElementById('svc-grid');
services.forEach(s => {
  // Убираем кнопку для мангала (id: 5) и рыбалки (id: 6)
  const showButton = s.id !== 5 && s.id !== 6;
  
  sg.innerHTML += `
    <div class="svc-card">
      <div>
        <div class="svc-card-img"><img src="${s.image}" alt="${s.name}" loading="lazy"></div>
        <h3>${s.name}</h3>
        <p class="desc">${s.description}</p>
        ${s.quote ? `<p class="quote">${s.quote}</p>` : ''}
      </div>
      ${showButton ? `<button class="svc-more" onclick="openPoolModal(${s.id})">Подробнее →</button>` : ''}
    </div>
  `;
});


// RENDER REVIEWS
const rs=document.getElementById('rs');
reviews.forEach(r=>{
  rs.innerHTML+=`<div class="rev-card"><div><div class="rev-stars">${'★'.repeat(r.stars).split('').map(()=>'<span class="rev-star">★</span>').join('')}</div><p class="rev-text">${r.text}</p></div><div class="rev-footer"><div class="rev-author"><span class="name">${r.author}</span><span class="label">Гость Горной Усадьбы</span></div><span class="rev-badge">Подтвержденный отзыв</span></div></div>`;
});

// RENDER CABINS
let selCabin = cabins[0].id;
let cabIdx = {};
cabins.forEach(c => cabIdx[c.id] = 0);

function renderCabins() {
  const cg = document.getElementById('cabins-grid');
  cg.innerHTML = '';
  cabins.forEach(c => {
    cg.innerHTML += `
      <div class="cabin-card">
        <div>
          <div class="cabin-gallery">
            <img src="${c.images[0]}" alt="${c.name}" loading="lazy">
            <div class="cabin-gallery-ov"></div>
            <span class="cabin-badge">${c.capacity}</span>
          </div>
          <div class="cabin-body">
            <h3>${c.name}</h3>
            <p class="desc">${c.description}</p>
          </div>
        </div>
        <div class="cabin-footer">
          <div class="cabin-price-row">
            <div>
              <p class="price-label">Стоимость проживания:</p>
              <div class="price-nums">
                <span class="amt">${c.priceLabel}</span>
              </div>
              <p class="price-disc" style="font-size:0.8rem;color:#78716c;font-weight:300;margin-top:0.25rem;font-style:italic;">${c.priceNote || ''}</p>
              ${c.disc ? `<p class="price-disc" style="color:var(--warm);margin-top:0.5rem;font-weight:500;">${c.disc}</p>` : ''}
            </div>
          </div>
          <div class="cabin-btns">
            <button class="btn-outline" onclick="openCabin('${c.id}')">Подробнее о домике</button>
            <button class="btn-fill" onclick="goto('booking')">Забронировать</button>
          </div>
        </div>
      </div>
    `;
  });
}

let cmIdx = 0;
let cmImages = [];

function openCabin(id) {
  const c = cabins.find(x => x.id === id);
  cmImages = c.images;
  cmIdx = 0;
  const img = document.getElementById('cm-img');
  img.src = '';
  const first = new Image();
  first.onload = function(){ img.src = cmImages[0]; };
  first.src = cmImages[0];
  document.getElementById('cm-badge').textContent = c.capacity;
  document.getElementById('cm-title').textContent = 'Домик «' + c.name + '»';
  document.getElementById('cm-desc').textContent = c.description;
  document.getElementById('cm-feats').innerHTML = c.features.map(f => `<div class="cabin-feat-item">✓ ${f}</div>`).join('');
  cmRenderDots();
  cmRenderArrows();
  openM('cabin-modal');
}

function renderCmSlider() {
  const img = document.getElementById('cm-img');
  const newSrc = cmImages[cmIdx];
  if (img.src.endsWith(newSrc) || img.getAttribute('src') === newSrc) {
    // уже показано — ничего не делаем
  } else {
    // Предзагружаем — показываем только когда готово
    const preload = new Image();
    preload.onload = function() {
      img.src = newSrc;
    };
    preload.src = newSrc;
  }
  cmRenderDots();
  cmRenderArrows();
}

function cmRenderDots() {
  const dc = document.getElementById('cm-dots');
  if (!dc) return;
  dc.innerHTML = cmImages.map((_, i) =>
    `<span onclick="cmGo(${i})" style="display:inline-block;width:${i===cmIdx?'1.4rem':'.4rem'};height:.4rem;border-radius:.2rem;background:${i===cmIdx?'#fff':'rgba(255,255,255,.4)'};cursor:pointer;transition:all .3s;"></span>`
  ).join('');
}

function cmRenderArrows() {
  const show = cmImages.length > 1 ? 'flex' : 'none';
  const al = document.getElementById('cm-arr-l');
  const ar = document.getElementById('cm-arr-r');
  if (al) al.style.display = show;
  if (ar) ar.style.display = show;
}

function cmGo(i) { cmIdx = i; renderCmSlider(); }
function cmNext() { cmIdx = (cmIdx + 1) % cmImages.length; renderCmSlider(); }
function cmPrev() { cmIdx = (cmIdx - 1 + cmImages.length) % cmImages.length; renderCmSlider(); }

renderCabins();

// BOOKING (временно отключено, пока нет формы)
const cabinSelEl = document.getElementById('cabin-sel');
if (cabinSelEl) {
  // Код активен только если есть элемент #cabin-sel
  cabins.forEach(c => {
    const el = document.createElement('div');
    el.className = 'cabin-opt' + (c.id === selCabin ? ' sel' : '');
    el.innerHTML = `<span class="cn">${c.name}</span><span class="cc">${c.capacity}</span>`;
    el.onclick = () => {
      selCabin = c.id;
      document.querySelectorAll('.cabin-opt').forEach(x => x.classList.remove('sel'));
      el.classList.add('sel');
      upd();
    };
    cabinSelEl.appendChild(el);
  });
}

// Функция обновления с проверкой существования элементов
function upd() {
  // Проверяем, что все элементы формы существуют
  const ci = document.getElementById('ci');
  const co = document.getElementById('co');
  const gs = document.getElementById('gs');
  const sCabin = document.getElementById('s-cabin');
  const sNights = document.getElementById('s-nights');
  const sGuests = document.getElementById('s-guests');
  const sBase = document.getElementById('s-base');
  const sDiscRow = document.getElementById('s-disc-row');
  const sDisc = document.getElementById('s-disc');
  const sTotal = document.getElementById('s-total');
  
  // Если хотя бы одного элемента нет — выходим (форма временно отключена)
  if (!ci || !co || !gs || !sCabin || !sNights || !sGuests || !sBase || !sDiscRow || !sDisc || !sTotal) {
    console.warn('⚠️ Форма бронирования временно отключена (заглушка)');
    return;
  }
  
  // Если все элементы есть — выполняем расчёт
  const c = cabins.find(x => x.id === selCabin);
  if (!c) return;
  
  const n = Math.max(1, Math.ceil((new Date(co.value) - new Date(ci.value)) / 86400000));
  const g = parseInt(gs.value) || 2;
  const base = c.pw * n;
  const ad = n >= 3;
  const disc = ad ? Math.round(base * 0.15) : 0;
  const total = base - disc;
  const ns = n === 1 ? 'ночь' : n < 5 ? 'ночи' : 'ночей';
  const gsText = g === 1 ? 'персона' : g < 5 ? 'персоны' : 'персон';
  
  sCabin.textContent = c.name;
  sNights.textContent = n + ' ' + ns;
  sGuests.textContent = g + ' ' + gsText;
  sBase.textContent = base.toLocaleString() + ' ₽';
  
  if (ad) {
    sDiscRow.style.display = 'flex';
    sDisc.textContent = '-' + disc.toLocaleString() + ' ₽';
  } else {
    sDiscRow.style.display = 'none';
  }
  sTotal.textContent = total.toLocaleString() + ' ₽';
}

