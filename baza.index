</div>

<!-- PRICE MODAL -->
<div class="modal" id="price-modal">
  <div class="modal-box price-modal-box">
    <button class="modal-close" style="background:#f5f5f4;color:#57534e" onclick="closeM('price-modal')">✕</button>
    <div class="price-modal-hdr">
      <span style="font-size:9px;font-family:monospace;text-transform:uppercase;letter-spacing:.25em;color:var(--warm);display:block;margin-bottom:.5rem">Актуальные тарифы</span>
      <h3 style="font-family:var(--serif);font-size:1.75rem;color:#1c1917">Прайс-лист Горной Усадьбы</h3>
      <p style="font-size:.875rem;color:#78716c;font-weight:300;margin-top:.375rem">Цены актуальны на текущий сезон 2026 года. Все налоги и базовая уборка включены.</p>
    </div>
    <div class="price-modal-wrap">
      <table class="price-tbl" id="price-tbl"></table>
    </div>
    <div class="price-modal-foot">
      <div class="price-modal-note">✦ Пользование теплым бассейном включено в проживание абсолютно бесплатно</div>
      <button class="btn-modal" onclick="closeM('price-modal');goto('booking')">Перейти к бронированию</button>
    </div>
  </div>
</div>

<script>
const scenarios=[
  {id:1,title:"Утро на террасе с кофе",description:"Вы просыпаетесь не от будильника, а от мягкого света на чистых хлопковых простынях. Выходите на террасу с чашкой свежего кофе. Перед вами - горы, лес, пруд. Тишина. Только вы, природа и этот уютный момент.",image:"images/2.jpg"},
  {id:2,title:"День у бассейна с видом на горы",description:"Тёплая вода, шезлонг, горы на горизонте. Вы ныряете, потом лежите, смотрите в небо. Дети плещутся рядом. Вы просто отдыхаете - без планов, без суеты.",image:"images/3.jpg"},
  {id:3,title:"Прогулка в лесу",description:"Вы берёте с собой свежесваренный кофе и выходите на лесную тропу. Идёте медленно, вдыхаете запах леса. Кофе согревает ладони, лес - душу. Никакой цели.",image:"images/4.jpg"},
  {id:4,title:"Баня на дровах с травяным чаем",description:"Жар и аромат натурального дерева. После парилки - глоток травяного чая с медом и вы чувствуете, что как будто заново родились. Баня, которая согревает не только тело, но и душу.",image:"images/5.jpg"},
  {id:5,title:"Семейный ужин у мангала",description:"Дрова прогорели до углей. Мясо шипит на решётке. Дети играют рядом. Ужин на природе - это маленькое семейное торжество, где никто не смотрит в телефон.",image:"images/6.jpg"},
  {id:6,title:"Вечер у костра с душевными разговорами",description:"Огонь потрескивает, над головой - звёзды. Вы сидите у костра в обнимку с близкими. Закутались в плед, в руке - кружка с горячим чаем. Настоящее тихое счастье.",image:"images/7.png"},
  {id:7,title:"Караоке для души (без соседей)",description:"Здесь, где никто не оценивает, вы берёте микрофон, включаете любимые песни и поёте. Громко, от души. Отдых по вашим правилам, где можно быть собой.",image:"images/8.jpg"},
  {id:8,title:"Сибирский чан с хвоей",description:"Аромат еловых веток, целебных трав и цитрусов в горячей воде. Звёзды, тишина, полное расслабление. Чан греет не только тело - он согревает изнутри.",image:"images/9.jpg"}
];
